.card.card-md
  .card-body
    %h2.h2.text-center.mb-4 Create an account
    = tag.div(flash[:alert], style: "color:red") if flash[:alert]
    = tag.div(flash[:notice], style: "color:green") if flash[:notice]
    = form_with model: @user, url: registration_url do |form|
      .mb-3
        %label.form-label Email address
        = form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address], class: "form-control"
      .mb-2
        %label.form-label
          Password
        .input-group.input-group-flat
          = form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "form-control"
      .mb-2
        %label.form-label
          Password Confirmation
        .input-group.input-group-flat
          = form.password_field :password_confirmation, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "form-control"
      .form-footer
        %button.btn.btn-primary.w-100{:type => "submit"} Sign up
.text-center.text-secondary.mt-3
  Already have an account ?
  = link_to "Sign in", new_session_path