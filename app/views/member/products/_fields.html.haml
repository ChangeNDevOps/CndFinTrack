= f.input :name
= f.input :description, as: :rich_text_area
= f.input :unit_price
= f.input :category_price,
  as: :select,
  wrapper: :horizontal_form,
  collection: f.object.class.category_prices.keys.map { |category_price| [category_price.titleize, category_price] },
  include_blank: false
= f.input :status,
  as: :select,
  wrapper: :horizontal_form,
  collection: f.object.class.statuses.keys.map { |status| [status.titleize, status] },
  include_blank: false

= f.association :tags,
  as: :select,
  wrapper: :horizontal_form,
  collection: @company.tags,
  input_html: { multiple: true, data: { controller: "tom-select" } }