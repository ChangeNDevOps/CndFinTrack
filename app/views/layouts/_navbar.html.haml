                %path{:d => "M9 15l-3.35 3.35"}
                %path{:d => "M5.65 5.65l3.35 3.35"}
                %path{:d => "M18.35 5.65l-3.35 3.35"}
            %span.nav-link-title Help
          .dropdown-menu
            %a.dropdown-item{:href => "https://tabler.io/docs", :rel => "noopener", :target => "_blank"} Documentation
            %a.dropdown-item{:href => "./changelog.html"} Changelog
            %a.dropdown-item{:href => "https://github.com/tabler/tabler", :rel => "noopener", :target => "_blank"} Source code
            %a.dropdown-item.text-pink{:href => "https://github.com/sponsors/codecalm", :rel => "noopener", :target => "_blank"}
              / Download SVG icon from http://tabler.io/icons/icon/heart
              %svg.icon.icon-inline.me-1.icon-2{:fill => "none", :height => "24", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2", :viewbox => "0 0 24 24", :width => "24", :xmlns => "http://www.w3.org/2000/svg"}
                %path{:d => "M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"}
              Sponsor project!
