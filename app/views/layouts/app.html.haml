%html{:lang => "en"}
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Cnd Fin Track"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Cnd Fin Track", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{:href => "/apple-touch-icon.png", :rel => "apple-touch-icon", :sizes => "180x180"}/
    %link{:href => "/favicon-32x32.png", :rel => "icon", :sizes => "32x32", :type => "image/png"}/
    %link{:href => "/favicon-16x16.png", :rel => "icon", :sizes => "16x16", :type => "image/png"}/
    %link{:href => "/site.webmanifest", :rel => "manifest"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    = stylesheet_link_tag :override, "data-turbo-track": "reload"
  %body{"data-bs-theme-primary" => "cyan"}
    .page
      = render partial: 'layouts/sticky_top'
      .page-wrapper
        .page-header.d-print-none{"aria-label" => "Page header"}
          .container-xl
            .row.g-2.align-items-center
              .col
                = render partial: 'breadcrumbs'
                %h2.page-title= page_title
              .col-auto.ms-auto.d-print-none
                .btn-list
                  - if add_button(:top)
                    = link_to add_button(:top)[:path], class: "btn btn-primary btn-5 d-none d-sm-inline-block" do
                      = icon add_button(:top)[:icon]
                      = add_button(:top)[:title]
        .page-body
          .container-xl
            .row.row-deck.row-cards
              = yield
        %footer.footer.footer-transparent.d-print-none
          .container-xl
            .row.text-center.align-items-center.flex-row-reverse
              .col-lg-auto.ms-lg-auto
                -# %ul.list-inline.list-inline-dots.mb-0
                -#   %li.list-inline-item
                -#     %a.link-secondary{:href => "https://docs.tabler.io", :rel => "noopener", :target => "_blank"} Documentation
                -#   %li.list-inline-item
                -#     %a.link-secondary{:href => "./license.html"} License
                -#   %li.list-inline-item
                -#     %a.link-secondary{:href => "https://github.com/tabler/tabler", :rel => "noopener", :target => "_blank"} Source code
                -#   %li.list-inline-item
                -#     %a.link-secondary{:href => "https://github.com/sponsors/codecalm", :rel => "noopener", :target => "_blank"}
                -#       / Download SVG icon from http://tabler.io/icons/icon/heart
                -#       %svg.icon.text-pink.icon-inline.icon-4{:fill => "none", :height => "24", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2", :viewbox => "0 0 24 24", :width => "24", :xmlns => "http://www.w3.org/2000/svg"}
                -#         %path{:d => "M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"}
                -#       Sponsor
              .col-12.col-lg-auto.mt-3.mt-lg-0
                %ul.list-inline.list-inline-dots.mb-0
                  %li.list-inline-item
                    Copyright © 2026
                    %a.link-secondary{:href => "."} Cnd Inc.
                    \. All rights reserved.
                  %li.list-inline-item
                    v#{Rails.configuration.version}
